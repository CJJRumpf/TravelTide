# PostgreSQL Database Configuration
# postgres://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require

# Component	Description
# USERNAME	DB_USER		between postgres:// and :
# PASSWORD	DB_PASSWORD	between : and @
# HOST	        DB_HOST		between @ and /
# DATABASE	DB_NAME		between / and ?
# PORT	        PostgreSQL port (default: 5432)
# sslmode=require	Enforces an encrypted SSL connection

DB_HOST=your_neon_host
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password
